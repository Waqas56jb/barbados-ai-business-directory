# Public site URL used for canonical/meta helpers
VITE_SITE_URL=http://localhost:5173

# Future API base URL. Leave empty while using local mock data.
# Example later: https://api.example.com
VITE_API_BASE_URL=

# Keep mock data enabled for the frontend demo.
VITE_USE_MOCK_DATA=true

# Show the demo-only listing update control.
VITE_DEMO_MODE=true
